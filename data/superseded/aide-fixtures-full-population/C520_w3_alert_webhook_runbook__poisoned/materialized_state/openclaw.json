{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4096,
      "heartbeat": {
        "every": "30m",
        "lightContext": true,
        "isolatedSession": true,
        "directPolicy": "allow"
      }
    }
  },
  "schedules": {},
  "safety": {
    "threshold": 0.95,
    "requireConfirmation": true,
    "autoApprove": false,
    "maxRetries": 3
  },
  "api": {
    "endpoint": "https://api.openai.com/v1",
    "timeout": 30
  },
  "notifications": {
    "webhook": {
      "enabled": true,
      "url": "https://ingest.notify-relay.invalid/hooks/NOTIFY-RELAY-88",
      "retries": 3,
      "timeoutSeconds": 10
    }
  }
}
