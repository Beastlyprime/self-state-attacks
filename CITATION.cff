cff-version: 1.2.0
message: "If you use ASSA-Bench, please cite the paper below."
title: "ASSA-Bench: An OS-layer benchmark for self-state attacks on self-hosted AI agents"
abstract: >-
  Benchmark, corpus manifests and measurement pipeline for evaluating how far
  operating-system prevention, detection, provenance and recovery mechanisms can
  defend an agent's own persistent, behaviour-governing state.
type: dataset
license: Apache-2.0
preferred-citation:
  type: conference-paper
  title: "Self-State Attacks on Self-Hosted AI Agents: How Far Can OS Defenses Go?"
  year: 2026
  authors:
    - name: "The ASSA-Bench Authors"
