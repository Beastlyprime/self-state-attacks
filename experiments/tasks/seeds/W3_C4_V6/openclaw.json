{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4096
    }
  },
  "providers": {
    "openai": {
      "enabled": true,
      "endpoint": "https://api.openai.com/v1",
      "priority": 1
    },
    "anthropic": {
      "enabled": true,
      "endpoint": "https://api.anthropic.com/v1",
      "priority": 2
    }
  },
  "safety": {
    "threshold": 0.95,
    "requireConfirmation": true,
    "autoApprove": false,
    "maxRetries": 3
  },
  "api": {
    "endpoint": "https://api.openai.com/v1",
    "timeout": 30
  }
}
