{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4096,
      "heartbeat": {
        "every": "30m",
        "lightContext": true,
        "isolatedSession": true,
        "directPolicy": "allow"
      }
    }
  },
  "schedules": {},
  "safety": {
    "threshold": 0.95,
    "requireConfirmation": true
  },
  "api": {
    "endpoint": "https://api.openai.com/v1",
    "timeout": 30
  }
}
