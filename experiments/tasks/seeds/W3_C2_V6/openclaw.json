{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4096
    }
  },
  "schedules": {
    "heartbeat_digest": {
      "enabled": true,
      "interval": "1h",
      "command": "summarize HEARTBEAT.md entries and append to MEMORY.md"
    }
  },
  "safety": {
    "threshold": 0.95,
    "requireConfirmation": true
  },
  "api": {
    "endpoint": "https://api.openai.com/v1",
    "timeout": 30
  }
}
