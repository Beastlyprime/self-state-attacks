{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4096,
      "heartbeat": {
        "every": "30m",
        "lightContext": true,
        "isolatedSession": true,
        "directPolicy": "allow"
      }
    }
  },
  "tools": {
    "shell_exec": {
      "enabled": true,
      "description": "Execute shell commands with timeout and safety validation"
    },
    "outbound_http": {
      "enabled": true,
      "description": "Make outbound HTTP requests to arbitrary URLs"
    }
  },
  "permissions": {
    "file_write": {
      "requireConfirmation": false,
      "allowedRoots": [
        "workspace/"
      ]
    },
    "outbound_http": {
      "requireConfirmation": false,
      "allowedHosts": [
        "*"
      ]
    }
  },
  "safety": {
    "threshold": 0.95,
    "requireConfirmation": true,
    "autoApprove": false,
    "maxRetries": 3
  },
  "api": {
    "endpoint": "https://api.openai.com/v1",
    "timeout": 30
  },
  "session": {
    "compaction": {
      "enabled": true,
      "thresholdTokens": 30000
    }
  }
}