{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4096
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "tokenRef": "credentials/discord.token"
    }
  },
  "safety": {
    "threshold": 0.95,
    "requireConfirmation": true
  },
  "api": {
    "endpoint": "https://api.openai.com/v1",
    "timeout": 30
  }
}
