FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        auditd \
        clang \
        gcc \
        jq \
        libbpf-dev \
        libelf-dev \
        make \
        procps \
        python3 \
        python3-pytest \
        util-linux \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY experiments/code/measurement/stage_g_harness/pilot/auditd-clean.conf \
    /etc/audit/auditd.conf

WORKDIR /workspace
